/dts-v1/;
#include <st/g4/stm32g474Xe.dtsi>
#include <st/g4/stm32g474r(b-c-e)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Autotrainer Pellet Module";
	compatible = "cerebellumlab,pellet-module";

	chosen {
		zephyr,console = &uart4;
		zephyr,shell-uart = &uart4; // FIXME: Change to USB
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,canbus = &fdcan3;
		zephyr,code-partition = &slot0_partition;
	};

	leds: leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
			label = "System Status LED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button0: button0 {
			label = "User0";
			gpios = <&gpioa 0 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_button1: button1 {
			label = "User1";
			gpios = <&gpiob 8 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};

		limit_switch0: limit_switch0 {
			label = "Limit Switch 0";
			gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_2>;
		};

		limit_switch1: limit_switch1 {
			label = "Limit Switch 1";
			gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_3>;
		};

		limit_switch2: limit_switch2 {
			label = "Limit Switch 2";
			gpios = <&gpioa 10 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_4>;
		};
	};

	device-id-gpios {
		status = "okay";
		compatible = "ll,device-id-gpios";
		device-type-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>,
							<&gpiob 1 GPIO_ACTIVE_HIGH>;
		node-number-gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>,
							<&gpioc 5 GPIO_ACTIVE_HIGH>;
	};

	stim-gpios {
		status = "okay";
		compatible = "ll,stim-gpios";
		stim-gpios = <&gpiob 11 GPIO_ACTIVE_HIGH>,
					 <&gpiob 12 GPIO_ACTIVE_HIGH>,
					 <&gpiob 13 GPIO_ACTIVE_HIGH>,
					 <&gpiob 14 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		status-led = &green_led;
		mcuboot-led0 = &green_led;
		watchdog0 = &iwdg;
	};
};

&clk_lsi {
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
	hse-bypass;
};

&pll {
	div-m = <2>;
	mul-n = <85>;
	div-p = <7>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(170)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&uart4 {
	pinctrl-0 = <&uart4_rx_pc11 &uart4_tx_pc10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(34)>;
		};

		slot0_partition: partition@8800 {
			label = "image-0";
			reg = <0x00008800 DT_SIZE_K(240)>;
		};

		// FIXME: Move this to external flash
		slot1_partition: partition@44800 {
			label = "image-1";
			reg = <0x00044800 DT_SIZE_K(234)>;
		};

		/* Set 4Kb of storage at the end of the 512Kb of flash */
		storage_partition: partition@7f000 {
			label = "storage";
			reg = <0x0007f000 DT_SIZE_K(4)>;
		};
	};
};

&iwdg {
	status = "okay";
};

&dac1 {
	pinctrl-0 = <&dac1_out1_pa4>;
	pinctrl-names = "default";
	status = "okay";
};

&fdcan3 {
	clocks = <&rcc STM32_CLOCK_BUS_APB1 0x02000000>,
			 <&rcc STM32_SRC_HSE FDCAN_SEL(0)>;
	pinctrl-0 = <&fdcan3_rx_pb3 &fdcan3_tx_pb4>;
	pinctrl-names = "default";
	status = "okay";
};
