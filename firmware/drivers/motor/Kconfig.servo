menuconfig LL_SERVO
        bool "Support LeafLabs servo driver"
        default y
        depends on DT_HAS_LL_SERVO_ENABLED
        select USE_STM32_LL_TIM
        select DMA
        help
            Enable support for the servo driver

config LL_SERVO_SHELL
        bool "Enable shell commands for servo driver"
        default y
        depends on LL_SERVO
        depends on SHELL
        help
            Enable shell commands for the servo driver
