	(text "Expected current consumption: 124mA\nSupports max 500mA"
		(exclude_from_sim no)
		(at 129.286 156.718 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "82d48cd6-ab7f-4f06-8fc6-48567f823722")
	)
	(text "Capacitor current\nIco(rms) = (Vout * (Vin - Vout))/(sqrt(12) * Vin * L * f_{sw})\nIco(rms) = 1.11 A"
		(exclude_from_sim no)
		(at 185.674 51.054 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "91bc7ded-a1f1-4880-b003-55c6be858cf3")
	)
	(text "Inductor selection math\n\nIpp = Vout/Vin(max) * (Vin(max) - Vout)/(Lo * fsw)\nIpp = 5/12.1 * (12.1 - 5)/(3.3uH * 550 kHz)\nIpp = 1.6 A\n\nIpeak = Io + Ipp/2 = 2.7 + 0.8 = 3.5 A\n\nIo(rms) = sqrt(Io^{2} + 1/12 Ipp^{2}) = 2.74 A"
		(exclude_from_sim no)
		(at 120.396 57.658 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c6cd160d-f610-47ab-ba28-4617391b7b5f")
	)
	(text "Vout = 0.76*(1+R20/R21)"
