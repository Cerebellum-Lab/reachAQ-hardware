	)
	(text "Inductor selection math\n\nIpp = Vout/Vin(max) * (Vin(max) - Vout)/(Lo * fsw)\nIpp = 5/12.1 * (12.1 - 5)/(3.3uH * 550 kHz)\nIpp = 1.6 A\n\nIpeak = Io + Ipp/2 = 2.7 + 0.8 = 3.5 A\n\nIo(rms) = sqrt(Io^{2} + 1/12 Ipp^{2}) = 2.74 A"
		(exclude_from_sim no)
		(at 120.396 57.658 0)
		(effects
